server {
  server_name teste.uaiviu.com.br;
  root /home/deploy/uaiviu/frontend-build/build;
  index index.html;
  location /wpp-teste/ {
    rewrite ^/wpp-teste/(.*)$ /$1 break;
    proxy_pass http://127.0.0.1:4002/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
  }

  location /whats-teste/ {
    proxy_pass http://127.0.0.1:4001/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/teste.uaiviu.com.br/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/teste.uaiviu.com.br/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = teste.uaiviu.com.br) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


  listen 80;
  server_name teste.uaiviu.com.br;
    return 404; # managed by Certbot


}
